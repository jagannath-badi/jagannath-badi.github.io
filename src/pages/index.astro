---
// src/pages/index.astro — Cinematic Hardware & Telemetry Engineering Portfolio
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import PinnedScene, { type SceneChapter } from '../components/PinnedScene.astro';
import OscilloscopeWorkbench from '../components/OscilloscopeWorkbench.astro';
import { createSupabaseServerClient } from '../lib/supabase';

// 1. Query Supabase for published projects (Zero DB modifications)
const supabase = createSupabaseServerClient(Astro);
const { data: dbProjects } = await supabase
  .from('projects')
  .select('id, slug, title, summary, project_type, is_featured')
  .eq('is_published', true)
  .order('sort_order', { ascending: true })
  .order('created_at', { ascending: false });

// 2. Realistic student engineering projects fallback if DB is empty
const fallbackProjects = [
  {
    id: 'fp-1',
    slug: 'microwave-telemetry-link',
    title: 'High-Speed Microwave Telemetry Link',
    summary: 'Planar patch array antenna frontend with 50-Ohm matched microstrip feedlines and shielded LNA/PA chains for long-range digital RF telemetry.',
    project_type: 'RF & WIRELESS',
    is_featured: true,
  },
  {
    id: 'fp-2',
    slug: 'freertos-embedded-controller',
    title: 'Deterministic FreeRTOS Motion Controller',
    summary: 'Cycle-accurate dual-core ARM/Xtensa firmware engine with sub-80ns interrupt jitter, zero-heap task scheduling, and hardware PWM timing.',
    project_type: 'EMBEDDED',
    is_featured: true,
  },
  {
    id: 'fp-3',
    slug: 'mixed-signal-dsp-analyzer',
    title: '24-Bit Mixed-Signal DSP Spectral Analyzer',
    summary: 'Low-noise analog conditioning circuit with 192 kSPS ADC sampling, digital IIR filtering, and real-time onboard FFT harmonic detection.',
    project_type: 'DSP & TELEMETRY',
    is_featured: false,
  },
  {
    id: 'fp-4',
    slug: 'differential-bus-transceiver',
    title: 'Length-Tuned Differential Sensor Bus',
    summary: '6-layer PCB stack-up with 100-Ohm differential impedance-controlled routing for high-baud RS-485, CAN-FD, and LVDS telemetry.',
    project_type: 'FIRMWARE / BUS',
    is_featured: false,
  },
];

const projects = (dbProjects && dbProjects.length > 0) ? dbProjects : fallbackProjects;

// Hero 3-Chapter Stack
const HERO_CHAPTERS: SceneChapter[] = [
  {
    id: 'rf-hero',
    anchor: 'hero-rf',
    index: '01',
    kicker: '01 // RF · FRONT-END',
    lines: ['Hardware', 'Logic.'],
    blooms: ['#00C2EE', '#FF2D95'],
    body: 'Bridging physical analog potentials to deterministic firmware and physical telemetry.',
    primary: { label: 'Explore Subsystems', href: '#subsystems' },
    secondary: { label: 'Launch DSP Lab', href: '#telemetry-workbench' },
    stats: [
      { label: 'Band', value: '2.4 GHz' },
      { label: 'Jitter', value: '< 80 ns' },
      { label: 'Uptime', value: '99.98%' },
    ],
    stage: {
      src: '/images/hardware-showcase.png',
      alt: 'RF hardware board lit with cyan and rose studio rim lighting',
      tag: 'Rev. C // RF-FE',
      status: 'Live',
    },
    rgb: [0, 184, 212],
  },
  {
    id: 'firmware-hero',
    anchor: 'hero-firmware',
    index: '02',
    kicker: '02 // FIRMWARE · CONTROL',
    lines: ['Silicon', 'Intent.'],
    blooms: ['#FF2D95', '#A47BFF'],
    body: 'Cycle-accurate interrupts and zero-heap scheduling turn every register write into a promise the hardware keeps.',
    primary: { label: 'Hardware Deployments', href: '#projects' },
    secondary: { label: 'Open Direct Uplink', href: '#uplink' },
    stats: [
      { label: 'Clock', value: '480 MHz' },
      { label: 'Latency', value: '1200 ns' },
      { label: 'Heap', value: '0 B' },
    ],
    stage: {
      src: '/images/stage-firmware.png',
      alt: 'Macro shot of a microcontroller on a PCB lit with neon magenta light',
      tag: 'MCU-X7 // FW 3.2',
      status: 'Locked',
    },
    rgb: [255, 43, 214],
  },
  {
    id: 'telemetry-hero',
    anchor: 'hero-telemetry',
    index: '03',
    kicker: '03 // MICROWAVE · TELEMETRY',
    lines: ['Signal', 'Returns.'],
    blooms: ['#A47BFF', '#00C2EE'],
    body: 'Phased arrays steer energy across the link and stream every measurement home, intact and time-stamped.',
    primary: { label: 'Deploy Ground Uplink', href: '#uplink' },
    secondary: { label: 'Browse Projects Matrix', href: '#projects' },
    stats: [
      { label: 'Channels', value: '64' },
      { label: 'Range', value: '12 km' },
      { label: 'Loss', value: '0.02%' },
    ],
    stage: {
      src: '/images/stage-telemetry.png',
      alt: 'Phased-array antenna module lit with deep violet microwave light',
      tag: 'PA-64 // Array',
      status: 'Linked',
    },
    rgb: [139, 61, 255],
  },
];

// Subsystem 4-Chapter Matrix
const SUBSYSTEM_CHAPTERS: SceneChapter[] = [
  {
    id: 'core-sub',
    anchor: 'sub-core',
    index: '01',
    kicker: '01 // CORE · PROCESSING',
    lines: ['Cortex', 'Cadence.'],
    blooms: ['#00C2EE', '#A47BFF'],
    body: 'Deterministic ARM Cortex-M firmware with bounded interrupt latency and cycle-accurate timing.',
    primary: { label: 'Next: RF Front-End', href: '#sub-rf' },
    secondary: { label: 'Open Ground Uplink', href: '#uplink' },
    stats: [
      { label: 'Core', value: 'Cortex-M7' },
      { label: 'Clock', value: '480 MHz' },
      { label: 'Latency', value: '1200 ns' },
    ],
    stage: {
      src: '/images/stage-core.png',
      alt: 'Macro shot of a Cortex-M microcontroller lit with deep cyan rim light',
      tag: 'CM7 // Core',
      status: 'Running',
    },
    rgb: [0, 184, 212],
  },
  {
    id: 'rf-sub',
    anchor: 'sub-rf',
    index: '02',
    kicker: '02 // RF · FRONTEND',
    lines: ['Tuned', 'Carrier.'],
    blooms: ['#FF2D95', '#00C2EE'],
    body: 'LNA, mixer and PA chains on impedance-matched microstrip, tuned from sub-GHz through 5.8 GHz.',
    primary: { label: 'Next: Differential Bus', href: '#sub-bus' },
    secondary: { label: 'Open Ground Uplink', href: '#uplink' },
    stats: [
      { label: 'Match', value: '50 Ω' },
      { label: 'S11', value: '< −15 dB' },
      { label: 'Band', value: '5.8 GHz' },
    ],
    stage: {
      src: '/images/stage-rf.png',
      alt: 'RF front-end board with shield can and SMA connector under magenta light',
      tag: 'LNA-PA // RF',
      status: 'Matched',
    },
    rgb: [255, 43, 214],
  },
  {
    id: 'bus-sub',
    anchor: 'sub-bus',
    index: '03',
    kicker: '03 // BUS · ROUTING',
    lines: ['Paired', 'Routing.'],
    blooms: ['#A47BFF', '#00C2EE'],
    body: 'Length-matched LVDS, CAN and RS-485 pairs with controlled impedance stack-ups and clean return paths.',
    primary: { label: 'Next: Telemetry DSP', href: '#sub-dsp' },
    secondary: { label: 'Open Ground Uplink', href: '#uplink' },
    stats: [
      { label: 'Diff', value: '100 Ω' },
      { label: 'Stack', value: '6-layer' },
      { label: 'Skew', value: '< 5 ps' },
    ],
    stage: {
      src: '/images/stage-bus.png',
      alt: 'Length-matched differential pair traces glowing violet on a multilayer board',
      tag: 'LVDS // 6L',
      status: 'Routed',
    },
    rgb: [139, 61, 255],
  },
  {
    id: 'dsp-sub',
    anchor: 'sub-dsp',
    index: '04',
    kicker: '04 // DSP · TELEMETRY',
    lines: ['Noise', 'Decoded.'],
    blooms: ['#FF2D95', '#00C2EE'],
    body: 'Real-time filtering, FFT and sensor fusion turning noisy physical signals into trustworthy data.',
    primary: { label: 'Launch DSP Lab', href: '#telemetry-workbench' },
    secondary: { label: 'View Project Matrix', href: '#projects' },
    stats: [
      { label: 'Depth', value: '24-bit' },
      { label: 'Rate', value: '192 kSPS' },
      { label: 'SNR', value: '112 dB' },
    ],
    stage: {
      src: '/images/stage-dsp.png',
      alt: 'ADC signal processing board in front of a glowing oscilloscope waveform',
      tag: 'ADC-24 // DSP',
      status: 'Streaming',
    },
    rgb: [255, 45, 149],
  },
];
---

<Layout title="JAGAN // ETC & HARDWARE LOGIC">
  <SiteNav />

  <main id="main-content">
    <!-- 1. Hero Pinned Scene -->
    <PinnedScene
      id="hero"
      label="Hardware stack in three chapters"
      chapters={HERO_CHAPTERS}
      primary={true}
      priority={true}
    />

    <!-- 2. Subsystems Matrix Pinned Scene -->
    <PinnedScene
      id="subsystems"
      label="Subsystem matrix in four chapters"
      chapters={SUBSYSTEM_CHAPTERS}
      stageOnMobile={true}
    />

    <!-- 3. Interactive DSP Oscilloscope Lab -->
    <OscilloscopeWorkbench />

    <!-- 4. Active Engineering Deployments (Supabase Live Integration + Fallback) -->
    <section id="projects" class="py-28 px-6 max-w-7xl mx-auto border-t border-white/10 relative">
      <div class="mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <div class="flex items-center gap-2 mb-3">
            <span class="w-2.5 h-2.5 rounded-full bg-[#00C2EE] animate-pulse"></span>
            <span class="font-mono text-xs text-[#00C2EE] uppercase tracking-[0.25em]">02 // SYSTEM REGISTRY</span>
          </div>
          <h2 class="text-3xl sm:text-5xl font-bold uppercase tracking-tight text-white">
            Active Hardware <span class="bloom text-[#FF2D95]" style="--bloom: #FF2D95;">Deployments.</span>
          </h2>
          <p class="text-slate-400 font-serif italic text-base sm:text-xl max-w-2xl mt-2">
            Structured specifications, bench-tested physical systems, and verified firmware monographs.
          </p>
        </div>

        <!-- Filter tabs -->
        <div class="flex flex-wrap items-center gap-2 p-1 rounded-xl bg-[#0B0D14] border border-white/10" id="project-filters">
          <button type="button" data-filter="all" class="proj-filter-btn active px-3.5 py-1.5 rounded-lg font-mono text-xs uppercase tracking-wider bg-[#00C2EE] text-black font-semibold transition-all">
            All Systems
          </button>
          <button type="button" data-filter="rf" class="proj-filter-btn px-3.5 py-1.5 rounded-lg font-mono text-xs uppercase tracking-wider text-slate-400 hover:text-white transition-all">
            RF / Wireless
          </button>
          <button type="button" data-filter="embedded" class="proj-filter-btn px-3.5 py-1.5 rounded-lg font-mono text-xs uppercase tracking-wider text-slate-400 hover:text-white transition-all">
            Embedded
          </button>
          <button type="button" data-filter="dsp" class="proj-filter-btn px-3.5 py-1.5 rounded-lg font-mono text-xs uppercase tracking-wider text-slate-400 hover:text-white transition-all">
            DSP &amp; Signal
          </button>
        </div>
      </div>

      <!-- Project Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="projects-grid">
        {projects.map((p, index) => (
          <article
            class="project-card p-8 rounded-2xl bg-[#07090E]/90 border border-white/10 hover:border-[#00C2EE]/60 transition-all duration-300 group relative overflow-hidden flex flex-col justify-between shadow-xl"
            data-type={(p.project_type || '').toLowerCase()}
          >
            <!-- Ambient hover glow -->
            <div class="absolute -right-20 -top-20 w-44 h-44 rounded-full bg-[#00C2EE]/10 blur-3xl pointer-events-none group-hover:bg-[#8B3DFF]/20 transition-all duration-500"></div>

            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="font-mono text-xs text-[#00C2EE] uppercase tracking-wider font-semibold">
                  CH 0{index + 1} // {p.project_type || 'SYSTEM'}
                </span>
                {p.is_featured && (
                  <span class="font-mono text-[9px] uppercase tracking-widest px-2.5 py-0.5 rounded-full bg-[#FF2D95]/15 text-[#FF2D95] border border-[#FF2D95]/30">
                    FEATURED
                  </span>
                )}
              </div>

              <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-[#00C2EE] transition-colors leading-snug">
                {p.title}
              </h3>

              <p class="text-sm text-slate-400 font-light leading-relaxed mb-8">
                {p.summary}
              </p>
            </div>

            <div class="pt-4 border-t border-white/5 flex items-center justify-between">
              <a
                href={`/projects/${p.slug}`}
                class="font-mono text-xs uppercase tracking-wider text-[#A47BFF] hover:text-[#00C2EE] transition-colors inline-flex items-center gap-2 font-semibold min-h-[44px]"
              >
                <span>Access Telemetry &amp; Specs</span>
                <span class="transition-transform group-hover:translate-x-1">→</span>
              </a>

              <span class="font-mono text-[10px] text-slate-500 uppercase tracking-widest">
                VERIFIED SPEC
              </span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 5. Ground Station Uplink & Transmission Console -->
    <section id="uplink" class="min-h-screen flex flex-col justify-center px-6 max-w-5xl mx-auto py-28 relative">
      <div class="mb-12 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 mb-4 font-mono text-xs text-[#00C2EE]">
          <span class="w-2 h-2 rounded-full bg-[#00FF9C] animate-pulse"></span>
          <span>GROUND STATION TRANSMISSION PORTAL</span>
        </div>
        <h2 class="text-3xl sm:text-6xl font-bold uppercase tracking-tight text-white">
          Open Direct <span class="bloom text-[#00C2EE]" style="--bloom: #00C2EE;">Uplink.</span>
        </h2>
        <p class="text-slate-400 font-serif italic text-base sm:text-2xl max-w-xl mx-auto mt-3">
          Send a transmission packet across the noise floor. Verified messages are logged and delivered in real-time.
        </p>
      </div>

      <!-- Transmission Form connected to real /api/contact endpoint -->
      <form
        id="uplink-form"
        method="post"
        action="/api/contact"
        class="glass p-8 sm:p-12 rounded-3xl border border-white/15 space-y-6 shadow-[0_0_60px_rgba(0,0,0,0.8)] relative"
      >
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="name" class="block font-mono text-xs uppercase tracking-[0.2em] text-slate-300 mb-2">
              Operator Callsign / Name
            </label>
            <input
              id="name"
              name="name"
              type="text"
              required
              placeholder="e.g. Lead Systems Engineer"
              class="w-full bg-[#040508] border border-white/15 rounded-xl px-4 py-3 text-white text-sm focus:border-[#00C2EE] focus-visible:ring-2 focus-visible:ring-[#00C2EE]/40 focus:outline-none transition-all placeholder:text-slate-600"
            />
          </div>

          <div>
            <label for="email" class="block font-mono text-xs uppercase tracking-[0.2em] text-slate-300 mb-2">
              Transmission Return Address
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              placeholder="operator@station.io"
              class="w-full bg-[#040508] border border-white/15 rounded-xl px-4 py-3 text-white text-sm focus:border-[#00C2EE] focus-visible:ring-2 focus-visible:ring-[#00C2EE]/40 focus:outline-none transition-all placeholder:text-slate-600"
            />
          </div>
        </div>

        <div>
          <label for="subject" class="block font-mono text-xs uppercase tracking-[0.2em] text-slate-300 mb-2">
            Mission / Channel Subject
          </label>
          <input
            id="subject"
            name="subject"
            type="text"
            required
            placeholder="RF Bring-up / Firmware Collaboration"
            class="w-full bg-[#040508] border border-white/15 rounded-xl px-4 py-3 text-white text-sm focus:border-[#A47BFF] focus-visible:ring-2 focus-visible:ring-[#A47BFF]/40 focus:outline-none transition-all placeholder:text-slate-600"
          />
        </div>

        <div>
          <label for="message" class="block font-mono text-xs uppercase tracking-[0.2em] text-slate-300 mb-2">
            Payload Telemetry Data
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            placeholder="Describe your hardware project, frequency band, or engineering inquiry..."
            class="w-full bg-[#040508] border border-white/15 rounded-xl px-4 py-3 text-white text-sm focus:border-[#FF2D95] focus-visible:ring-2 focus-visible:ring-[#FF2D95]/40 focus:outline-none transition-all placeholder:text-slate-600 resize-none"
          ></textarea>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pt-4 border-t border-white/10">
          <p id="uplink-status" role="status" aria-live="polite" class="font-mono text-xs text-slate-400">
            Channel idle // Link ready
          </p>

          <button
            type="submit"
            id="uplink-submit-btn"
            class="button button-primary min-h-[48px] px-8 rounded-full font-mono text-xs uppercase tracking-[0.25em] font-bold"
          >
            Deploy Transmission ↗
          </button>
        </div>
      </form>
    </section>
  </main>

  <footer class="border-t border-white/10 bg-[#040508] py-10 px-6 mt-16">
    <div class="shell flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs text-slate-500">
      <div>
        <span>© {new Date().getFullYear()} JAGAN // ECE</span>
        <span class="mx-2 text-white/20">|</span>
        <span class="text-slate-400">ELECTRONICS &amp; TELECOMMUNICATION ENGINEERING</span>
      </div>
      <div class="flex items-center gap-6">
        <a href="https://github.com/jagannath-badi" target="_blank" rel="noopener noreferrer" class="hover:text-[#00C2EE] transition-colors">
          GITHUB // @JAGANNATH-BADI ↗
        </a>
        <a href="/admin" class="hover:text-[#A47BFF] transition-colors">
          ADMIN [OP]
        </a>
      </div>
    </div>
  </footer>
</Layout>

<script>
  function initPageInteractions() {
    // 1. Projects Filter Logic
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.proj-filter-btn');
    const projectCards = document.querySelectorAll<HTMLElement>('.project-card');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => {
          b.classList.remove('bg-[#00C2EE]', 'text-black', 'font-semibold');
          b.classList.add('text-slate-400');
        });
        btn.classList.add('bg-[#00C2EE]', 'text-black', 'font-semibold');
        btn.classList.remove('text-slate-400');

        const filter = btn.getAttribute('data-filter') || 'all';

        projectCards.forEach((card) => {
          const type = card.getAttribute('data-type') || '';
          if (filter === 'all' || type.includes(filter)) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // 2. Uplink Form Submission via /api/contact
    const form = document.querySelector<HTMLFormElement>('#uplink-form');
    const statusEl = document.querySelector<HTMLElement>('#uplink-status');
    const submitBtn = document.querySelector<HTMLButtonElement>('#uplink-submit-btn');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!statusEl || !form.checkValidity()) return;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Transmitting Packet…';
      }
      statusEl.textContent = 'Transmitting packet across noise floor...';
      statusEl.classList.remove('text-red-400', 'text-[#00FF9C]');
      statusEl.classList.add('text-[#00C2EE]');

      try {
        const formData = new FormData(form);
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(formData)),
        });

        if (res.ok) {
          statusEl.textContent = '✓ Transmission received, logged and queued.';
          statusEl.classList.remove('text-[#00C2EE]');
          statusEl.classList.add('text-[#00FF9C]');
          form.reset();
        } else {
          statusEl.textContent = '✗ Transmission rejected by ground station.';
          statusEl.classList.remove('text-[#00C2EE]');
          statusEl.classList.add('text-red-400');
        }
      } catch {
        statusEl.textContent = '✗ Network link failure. Packet dropped.';
        statusEl.classList.remove('text-[#00C2EE]');
        statusEl.classList.add('text-red-400');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Deploy Transmission ↗';
        }
      }
    });
  }

  document.addEventListener('astro:page-load', initPageInteractions);
</script>
