---
// src/pages/index.astro — EnduroSat-Grade Hardware & Telecommunications Showcase
import Layout from '../layouts/Layout.astro';
import FullWorld3D from '../components/FullWorld3D.astro';
import { createSupabaseServerClient } from '../lib/supabase';
import { parseCaseStudy } from '../lib/case-study-schema';

// Fetch published projects from Supabase with strict publication filtering
const supabase = createSupabaseServerClient(Astro);
const { data: dbProjects } = await supabase
	.from('projects')
	.select(
		'id, slug, title, summary, description, technologies, project_type, is_featured, github_url, demo_url, sort_order, created_at'
	)
	.eq('is_published', true)
	.order('sort_order', { ascending: true })
	.order('created_at', { ascending: false });

const allPublishedProjects = dbProjects ?? [];

// Separate featured vs secondary published projects (never duplicate)
const featuredProjects = allPublishedProjects.filter((p) => p.is_featured);
const secondaryProjects = allPublishedProjects.filter((p) => !p.is_featured);
---

<Layout title="Jagan — Hardware Logic & Telecommunication Engineering">
	<FullWorld3D />

	<!-- Fixed Minimal Aerospace Navigation Bar -->
	<header class="site-header border-b border-white/[0.08] bg-[#020408]/85 backdrop-blur-md sticky top-0 z-40">
		<div class="shell max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between py-3.5 relative">
			<a class="wordmark flex items-center gap-3 group" href="/" aria-label="Jagan home">
				<span class="inline-flex items-center justify-center w-6 h-6 text-[10px] font-mono font-bold text-[#00A3FF] bg-[#00A3FF]/10 border border-[#00A3FF]/30 rounded-xs transition-colors group-hover:border-white group-hover:text-white" aria-hidden="true">[E]</span>
				<span class="font-mono tracking-wider font-semibold text-white text-xs">JAGAN &nbsp;EMBEDDED SYSTEMS</span>
			</a>
			<nav class="site-nav flex items-center gap-6" aria-label="Primary navigation">
				<button
					class="menu-toggle sm:hidden inline-flex items-center justify-center w-11 h-11 rounded-sm border border-white/10 bg-[#070c14] text-white hover:border-[#00A3FF]/40 transition-colors"
					type="button"
					aria-expanded="false"
					aria-controls="primary-navigation"
					aria-label="Toggle navigation"
				>
					<span class="sr-only">Toggle navigation</span>
					<svg
						class="hamburger-icon w-5 h-5 pointer-events-none"
						viewBox="0 0 20 20"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"
						aria-hidden="true"
					>
						<line class="line-top" x1="3" y1="5" x2="17" y2="5"></line>
						<line class="line-mid" x1="3" y1="10" x2="17" y2="10"></line>
						<line class="line-bot" x1="3" y1="15" x2="17" y2="15"></line>
					</svg>
				</button>
				<ul class="nav-list flex items-center gap-6 font-mono text-xs text-slate-400" id="primary-navigation">
					<li><a href="#challenge" data-nav-link class="hover:text-[#00A3FF] transition-colors">Architecture</a></li>
					<li><a href="#projects" data-nav-link class="hover:text-[#00A3FF] transition-colors">Payloads</a></li>
					<li><a href="#specs" data-nav-link class="hover:text-[#00A3FF] transition-colors">Specifications</a></li>
					<li><a href="#contact" data-nav-link class="hover:text-[#00A3FF] transition-colors">Contact</a></li>
				</ul>
				<a href="#contact" class="hidden sm:inline-flex enduro-btn text-[11px]">
					<span>TRANSMISSION</span>
					<span class="badge-icon" aria-hidden="true">↗</span>
				</a>
			</nav>
		</div>
		<div class="scroll-progress-bar" aria-hidden="true"></div>
	</header>

	<main id="main-content">
		<!-- SECTION 1: HERO (50/50 Desktop Split — Absolute Zero Occlusion on Right) -->
		<section class="min-h-[calc(100vh-64px)] flex items-center relative overflow-hidden py-16 sm:py-24" aria-labelledby="hero-title">
			<div class="shell w-full max-w-7xl mx-auto px-4 sm:px-6">
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
					<!-- Left 6 Columns: Monumental Neo-Grotesque Display & Engineering Brief -->
					<div class="lg:col-span-6 flex flex-col items-start" data-reveal>
						<div class="flex items-center gap-2 mb-4" data-hero-item="0">
							<span class="w-1.5 h-1.5 rounded-full bg-[#00A3FF] animate-pulse" aria-hidden="true"></span>
							<p class="kicker-cyan">
								Physical-Digital Systems &amp; Telecommunications
							</p>
						</div>
						<h1 id="hero-title" class="font-display font-extrabold text-4xl sm:text-6xl lg:text-[68px] tracking-[-0.04em] leading-[0.95] text-white mb-6 uppercase" data-hero-item="1">
							HARDWARE LOGIC.<br />
							<span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-slate-200 to-[#00A3FF]">ENGINEERED FOR THE EDGE.</span>
						</h1>
						<p class="text-base sm:text-lg text-slate-300 max-w-xl leading-relaxed mb-8 font-light" data-hero-item="2">
							B.Tech Electronics &amp; Communication Engineering undergraduate combining sensor acquisition, ESP32 deterministic firmware, and applied software tools for reliable physical computing.
						</p>
						<div class="flex flex-wrap items-center gap-4" data-hero-item="2">
							<a class="enduro-btn" href="#projects">
								<span>EXPLORE ARCHITECTURE</span>
								<span class="badge-icon" aria-hidden="true">↗</span>
							</a>
							<a class="enduro-btn" href="#contact">
								<span>ESTABLISH UPLINK</span>
								<span class="badge-icon" aria-hidden="true">↗</span>
							</a>
						</div>
					</div>

					<!-- Right 6 Columns: Reserved Exclusively for EnduroSat 3D Microsatellite (Zero DOM Collision) -->
					<div class="hidden lg:block lg:col-span-6 pointer-events-none min-h-[460px]" aria-hidden="true">
						<!-- Viewport spatial zone intentionally kept clear so WebGL centerpiece shines through unobstructed -->
					</div>
				</div>
			</div>
		</section>

		<!-- SECTION 2: THE CHALLENGE -->
		<section class="monograph-section py-20 sm:py-32 relative" id="challenge" aria-labelledby="challenge-title">
			<div class="shell max-w-7xl mx-auto px-4 sm:px-6">
				<div class="max-w-3xl" data-reveal>
					<p class="kicker-orange mb-4">THE CHALLENGE</p>
					<h2 id="challenge-title" class="font-display font-semibold text-3xl sm:text-5xl lg:text-[46px] tracking-[-0.03em] leading-[1.12] text-white">
						Building deterministic embedded hardware, low-noise analog signal chains, and real-time firmware architectures without bloated abstractions.
					</h2>
				</div>
			</div>
		</section>

		<!-- SECTION 3: PAYLOAD INTEGRATION & HARDWARE ARCHITECTURE -->
		<section class="monograph-section min-h-[90vh] flex flex-col justify-between py-16 sm:py-24 relative" id="projects" aria-labelledby="projects-title">
			<div class="shell max-w-7xl mx-auto px-4 sm:px-6 w-full">
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
					<!-- Left 5 Columns: Title, Subsystem Spec Readout & Direct Case Study Links -->
					<div class="lg:col-span-5 max-w-md z-10" data-reveal>
						<p class="kicker-cyan mb-2">Payload Integration</p>
						<h2 id="projects-title" class="font-display font-semibold text-3xl sm:text-4xl lg:text-[42px] tracking-[-0.03em] leading-[1.08] text-white mb-4">
							Payload Integration &amp; Hardware Architecture
						</h2>
						<p class="text-sm text-slate-400 leading-relaxed mb-6 font-light">
							End-to-end qualification of mixed-signal sensor acquisition, bus controllers, and deterministic firmware for physical deployment.
						</p>

						<!-- Dynamic Subsystem Readout based on Stepper -->
						<div id="step-readout" class="p-4 bg-[#070c14]/85 border border-white/10 rounded-sm font-mono text-xs space-y-1.5 backdrop-blur-md">
							<p id="step-title" class="text-[#00A3FF] font-semibold">01 // ARCHITECTURE &amp; DESIGN</p>
							<p id="step-desc" class="text-slate-300">Mixed-signal schematic capture, power distribution budgeting, and sensor interfacing.</p>
						</div>

						{featuredProjects.length > 0 && (
							<div class="mt-6 flex flex-wrap gap-3">
								{featuredProjects.slice(0, 2).map((p) => (
									<a class="enduro-btn text-[11px]" href={`/projects/${p.slug}`}>
										<span>{p.title}</span>
										<span class="badge-icon" aria-hidden="true">↗</span>
									</a>
								))}
							</div>
						)}
					</div>

					<!-- Right 7 Columns: Completely unobstructed for 3D Satellite & Isometric Grid -->
					<div class="lg:col-span-7 min-h-[420px] pointer-events-none" aria-hidden="true">
						<!-- Spatial corridor for EnduroSat satellite pivot -->
					</div>
				</div>
			</div>

			<!-- Bottom Pinned Pipeline Stepper -->
			<div class="shell max-w-7xl mx-auto px-4 sm:px-6 w-full mt-12 flex justify-center">
				<div class="progress-stepper" role="tablist" aria-label="Payload Subsystem Pipeline">
					<button class="progress-step active" type="button" data-step="0">DESIGN</button>
					<button class="progress-step" type="button" data-step="1">AIT</button>
					<button class="progress-step" type="button" data-step="2">FIRMWARE</button>
					<button class="progress-step" type="button" data-step="3">OPS</button>
				</div>
			</div>
		</section>

		<!-- SECTION 4: CORE SUBSYSTEM SPECIFICATIONS -->
		<section class="monograph-section py-20 sm:py-32 relative" id="specs" aria-labelledby="specs-title">
			<div class="shell max-w-7xl mx-auto px-4 sm:px-6">
				<div class="max-w-4xl mb-12 sm:mb-16">
					<p class="kicker-orange mb-3">Subsystem Matrix</p>
					<h2 id="specs-title" class="font-display font-semibold text-3xl sm:text-5xl lg:text-[46px] tracking-[-0.03em] leading-[1.08] text-white">
						Core Subsystem Specifications
					</h2>
				</div>

				<!-- 4-Column Technical Specification Matrix -->
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
					<!-- Subsystem 01: Core Logic -->
					<div class="enduro-card p-6 flex flex-col justify-between" data-reveal>
						<div>
							<div class="flex items-center justify-between mb-4 pb-2.5 border-b border-white/[0.08]">
								<span class="font-mono text-[10px] text-[#00A3FF] font-semibold">BUS 01 // COMPUTING</span>
								<span class="font-mono text-[10px] text-slate-500">MCU</span>
							</div>
							<h3 class="font-display font-semibold text-lg text-white tracking-tight mb-2">Processing &amp; Core Logic</h3>
							<p class="text-xs text-slate-400 mb-5 leading-relaxed font-light">
								Microcontroller platform architecture, memory mapping, interrupt handlers, and hardware timers.
							</p>
						</div>
						<div class="font-mono text-xs space-y-2 bg-[#020408]/60 p-3.5 border border-white/[0.06] rounded-sm">
							<div class="flex justify-between"><span class="text-slate-500">MCU</span><span class="text-white">ESP32 Dual Xtensa</span></div>
							<div class="flex justify-between border-t border-white/[0.04] pt-1.5"><span class="text-slate-500">ARCH</span><span class="text-white">ARM Cortex-M</span></div>
							<div class="flex justify-between border-t border-white/[0.04] pt-1.5"><span class="text-slate-500">OS</span><span class="text-[#00A3FF]">FreeRTOS Kernel</span></div>
							<div class="flex justify-between border-t border-white/[0.04] pt-1.5"><span class="text-slate-500">TIMER</span><span class="text-white">Hardware PWM/ISR</span></div>
						</div>
					</div>

					<!-- Subsystem 02: Signal Conditioning & RF -->
					<div class="enduro-card p-6 flex flex-col justify-between" data-reveal style="--reveal-delay: 80ms">
						<div>
							<div class="flex items-center justify-between mb-4 pb-2.5 border-b border-white/[0.08]">
								<span class="font-mono text-[10px] text-[#FF5C00] font-semibold">BUS 02 // SENSORS</span>
								<span class="font-mono text-[10px] text-slate-500">ANALOG</span>
							</div>
							<h3 class="font-display font-semibold text-lg text-white tracking-tight mb-2">Signal Conditioning &amp; RF</h3>
							<p class="text-xs text-slate-400 mb-5 leading-relaxed font-light">
								Operational amplifier filtering, sensor impedance matching, multi-ADC sampling, and comms.
							</p>
						</div>
						<div class="font-mono text-xs space-y-2 bg-[#020408]/60 p-3.5 border border-white/[0.06] rounded-sm">
							<div class="flex justify-between"><span class="text-slate-500">OP-AMP</span><span class="text-white">Active Filters / Gain</span></div>
							<div class="flex justify-between border-t border-white/[0.04] pt-1.5"><span class="text-slate-500">ADC</span><span class="text-white">12-Bit Multi-Ch</span></div>
							<div class="flex justify-between border-t border-white/[0.04] pt-1.5"><span class="text-slate-500">BUS</span><span class="text-[#FF5C00]">I2C / SPI / UART</span></div>
							<div class="flex justify-between border-t border-white/[0.04] pt-1.5"><span class="text-slate-500">RF</span><span class="text-white">ISM Band / Wi-Fi</span></div>
						</div>
					</div>

					<!-- Subsystem 03: Power & Actuation -->
					<div class="enduro-card p-6 flex flex-col justify-between" data-reveal style="--reveal-delay: 160ms">
						<div>
							<div class="flex items-center justify-between mb-4 pb-2.5 border-b border-white/[0.08]">
								<span class="font-mono text-[10px] text-[#00A3FF] font-semibold">BUS 03 // POWER</span>
								<span class="font-mono text-[10px] text-slate-500">SWITCH</span>
							</div>
							<h3 class="font-display font-semibold text-lg text-white tracking-tight mb-2">Power &amp; Actuation</h3>
							<p class="text-xs text-slate-400 mb-5 leading-relaxed font-light">
								Isolated switching stages, high-current relay drivers, solenoid valves, and regulated DC rails.
							</p>
						</div>
						<div class="font-mono text-xs space-y-2 bg-[#020408]/60 p-3.5 border border-white/[0.06] rounded-sm">
							<div class="flex justify-between"><span class="text-slate-500">DRIVE</span><span class="text-white">Opto-Isolated Relays</span></div>
							<div class="flex justify-between border-t border-white/[0.04] pt-1.5"><span class="text-slate-500">VALVE</span><span class="text-white">12V Solenoid Logic</span></div>
							<div class="flex justify-between border-t border-white/[0.04] pt-1.5"><span class="text-slate-500">SUPPLY</span><span class="text-[#00A3FF]">LDO / Buck 3.3V-12V</span></div>
							<div class="flex justify-between border-t border-white/[0.04] pt-1.5"><span class="text-slate-500">SAFETY</span><span class="text-white">Flyback &amp; TVS Diode</span></div>
						</div>
					</div>

					<!-- Subsystem 04: Software & AI Telemetry -->
					<div class="enduro-card p-6 flex flex-col justify-between" data-reveal style="--reveal-delay: 240ms">
						<div>
							<div class="flex items-center justify-between mb-4 pb-2.5 border-b border-white/[0.08]">
								<span class="font-mono text-[10px] text-[#FF5C00] font-semibold">BUS 04 // SOFTWARE</span>
								<span class="font-mono text-[10px] text-slate-500">AI / WEB</span>
							</div>
							<h3 class="font-display font-semibold text-lg text-white tracking-tight mb-2">Software &amp; AI Telemetry</h3>
							<p class="text-xs text-slate-400 mb-5 leading-relaxed font-light">
								Data capture pipelines, interactive WebGL interfaces, multi-model AI APIs, and full telemetry.
							</p>
						</div>
						<div class="font-mono text-xs space-y-2 bg-[#020408]/60 p-3.5 border border-white/[0.06] rounded-sm">
							<div class="flex justify-between"><span class="text-slate-500">TOOLING</span><span class="text-white">Python / NumPy</span></div>
							<div class="flex justify-between border-t border-white/[0.04] pt-1.5"><span class="text-slate-500">UI</span><span class="text-white">Streamlit / Astro</span></div>
							<div class="flex justify-between border-t border-white/[0.04] pt-1.5"><span class="text-slate-500">AI</span><span class="text-[#FF5C00]">Multi-Model Vision</span></div>
							<div class="flex justify-between border-t border-white/[0.04] pt-1.5"><span class="text-slate-500">3D</span><span class="text-white">Three.js / WebGL</span></div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- SECTION 5: MISSION UPLINK (CONTACT) -->
		<section class="monograph-section py-20 sm:py-32 relative" id="contact" aria-labelledby="contact-title">
			<div class="shell max-w-7xl mx-auto px-4 sm:px-6">
				<div class="max-w-4xl mb-12 sm:mb-16">
					<p class="kicker-cyan mb-3">Mission Uplink</p>
					<h2 id="contact-title" class="font-display font-semibold text-3xl sm:text-5xl lg:text-[46px] tracking-[-0.03em] leading-[1.08] text-white">
						Initiate Direct Transmission
					</h2>
				</div>

				<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start" data-reveal>
					<!-- Left 4 Columns: Communication Telemetry Specs -->
					<div class="lg:col-span-4 space-y-6">
						<h3 class="font-display font-semibold text-xl text-white tracking-tight">
							Ground Station &amp; Contact Telemetry
						</h3>
						<p class="text-sm text-slate-300 leading-relaxed font-light">
							Have an engineering question, technical feedback, or an embedded hardware/software project to discuss? Transmit a packet directly to my inbox.
						</p>
						<div class="space-y-3 font-mono text-xs bg-[#070c14]/90 p-5 border border-white/[0.08] rounded-sm">
							<div class="flex items-center justify-between">
								<span class="text-slate-500">OPERATOR</span>
								<span class="text-white font-semibold">Jagan (B.Tech ECE, Sri Sri University)</span>
							</div>
							<div class="flex items-center justify-between border-t border-white/[0.04] pt-2">
								<span class="text-slate-500">RESPONSE WINDOW</span>
								<span class="text-[#10B981] font-semibold">Within 24–48 Hours</span>
							</div>
							<div class="flex items-center justify-between border-t border-white/[0.04] pt-2">
								<span class="text-slate-500">PROTOCOL</span>
								<span class="text-[#00A3FF]">Direct TLS Telemetry</span>
							</div>
							<div class="flex items-center justify-between border-t border-white/[0.04] pt-2">
								<span class="text-slate-500">SECURITY</span>
								<span class="text-[#FF5C00]">Rate-Limited Anti-Spam</span>
							</div>
						</div>
					</div>

					<!-- Right 8 Columns: Contact Form (Directly wired to /api/contact) -->
					<div class="lg:col-span-8 enduro-card p-6 sm:p-10">
						<form id="contact-form" method="post" action="/api/contact" class="space-y-5">
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
								<div>
									<label for="contact-name" class="font-mono text-xs block mb-2 text-slate-300">
										OPERATOR NAME <span class="text-[#FF5C00]">*</span>
									</label>
									<input id="contact-name" name="name" type="text" autocomplete="name" minlength="2" maxlength="100" required class="form-input w-full p-3 font-mono text-xs" placeholder="Identify operator or name" />
								</div>
								<div>
									<label for="contact-email" class="font-mono text-xs block mb-2 text-slate-300">
										TRANSMISSION EMAIL <span class="text-[#FF5C00]">*</span>
									</label>
									<input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required class="form-input w-full p-3 font-mono text-xs" placeholder="operator@domain.com" />
								</div>
							</div>

							<div>
								<label for="contact-subject" class="font-mono text-xs block mb-2 text-slate-300">
									MISSION SUBJECT <span class="text-[#FF5C00]">*</span>
								</label>
								<input id="contact-subject" name="subject" type="text" maxlength="150" required class="form-input w-full p-3 font-mono text-xs" placeholder="Inquiry, payload design, or feedback topic" />
							</div>

							<div>
								<label for="contact-message" class="font-mono text-xs block mb-2 text-slate-300">
									PAYLOAD PACKET / MESSAGE <span class="text-[#FF5C00]">*</span>
								</label>
								<textarea id="contact-message" name="message" minlength="10" maxlength="5000" rows="5" required class="form-textarea w-full p-3 font-mono text-xs" placeholder="Specify technical parameters, system requirements, or inquiries…"></textarea>
							</div>

							<!-- Honeypot anti-spam field -->
							<div class="hidden" aria-hidden="true">
								<label for="contact-website">Website</label>
								<input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
							</div>

							<div class="pt-3 flex flex-wrap items-center justify-between gap-4">
								<button type="submit" class="enduro-btn">
									<span>TRANSMIT PACKET</span>
									<span class="badge-icon" aria-hidden="true">↗</span>
								</button>
								<p id="contact-status" class="font-mono text-xs" role="status" aria-live="polite"></p>
							</div>
						</form>
					</div>
				</div>
			</div>
		</section>
	</main>

	<!-- EnduroSat Aerospace Footer -->
	<footer class="site-footer bg-[#020408] border-t border-white/[0.08] py-10 relative z-10">
		<div class="shell max-w-7xl mx-auto px-4 sm:px-6 flex flex-wrap items-center justify-between gap-4 font-mono text-xs text-slate-500">
			<div>
				<span class="text-white font-semibold">© {new Date().getFullYear()} JAGAN</span>
				<span class="mx-3 text-white/20">|</span>
				<span>ELECTRONICS &amp; COMMUNICATION ENGINEERING</span>
			</div>
			<div class="flex items-center gap-6">
				<a href="https://github.com/jagannath-badi" target="_blank" rel="noopener noreferrer" class="hover:text-[#00A3FF] transition-colors">
					GITHUB // @JAGANNATH-BADI ↗
				</a>
				<a href="/admin" class="hover:text-white transition-colors">
					ADMIN [OP]
				</a>
			</div>
		</div>
	</footer>
</Layout>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	gsap.registerPlugin(ScrollTrigger);

	// Progressive Enhancement: reveal items & active navigation
	const root = document.documentElement;
	root.classList.add('js');

	const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (prefersReducedMotion || !('IntersectionObserver' in window)) {
		revealItems.forEach((item) => item.classList.add('is-visible'));
	} else {
		const revealObserver = new IntersectionObserver(
			(entries, observer) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						const item = entry.target as HTMLElement;
						item.style.transitionDelay = item.dataset.reveal ? (item.style.getPropertyValue('--reveal-delay') || '0ms') : '0ms';
						item.classList.add('is-visible');
						observer.unobserve(item);
					}
				});
			},
			{ threshold: 0.1, rootMargin: '0px 0px -30px' }
		);
		revealItems.forEach((item) => revealObserver.observe(item));
	}

	// Hero Entrance Animation (GSAP)
	try {
		const heroItems = Array.from(document.querySelectorAll<HTMLElement>('[data-hero-item]'))
			.sort((a, b) => Number(a.dataset.heroItem) - Number(b.dataset.heroItem));

		if (heroItems.length && !prefersReducedMotion) {
			const tl = gsap.timeline({ defaults: { ease: 'power3.out', duration: 0.6 } });
			heroItems.forEach((el, i) => {
				const delay = [0, 0.08, 0.16][i] ?? i * 0.08;
				tl.from(el, { opacity: 0, y: 16, clearProps: 'all' }, delay);
			});
		} else if (heroItems.length) {
			heroItems.forEach((el) => { el.style.opacity = '1'; el.style.transform = 'none'; });
		}
	} catch (_) {}

	// Scroll Progress Bar
	try {
		const bar = document.querySelector<HTMLElement>('.scroll-progress-bar');
		if (bar) {
			const updateBar = () => {
				const scrollTop = window.scrollY;
				const docH = document.documentElement.scrollHeight - window.innerHeight;
				bar.style.transform = `scaleX(${docH > 0 ? scrollTop / docH : 0})`;
			};
			window.addEventListener('scroll', updateBar, { passive: true });
			updateBar();
		}
	} catch (_) {}

	// Section Scroll-Spy & Active Navigation
	try {
		const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
		const sectionIds = ['challenge', 'projects', 'specs', 'contact'];
		const sections = sectionIds.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];

		if (navLinks.length && sections.length) {
			let activeId = '';
			const setActive = (id: string) => {
				if (id === activeId) return;
				activeId = id;
				navLinks.forEach((a) => {
					const href = a.getAttribute('href')?.replace('#', '');
					const isActive = href === id;
					a.style.color = isActive ? '#00A3FF' : '';
					if (isActive) {
						a.setAttribute('aria-current', 'page');
					} else {
						a.removeAttribute('aria-current');
					}
				});
			};

			navLinks.forEach((a) => {
				a.addEventListener('click', () => {
					const href = a.getAttribute('href')?.replace('#', '');
					if (href) setActive(href);
				});
			});

			const spyObserver = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) setActive((entry.target as HTMLElement).id);
					});
				},
				{ rootMargin: '-25% 0px -55% 0px', threshold: 0 }
			);
			sections.forEach((s) => spyObserver.observe(s));
		}
	} catch (_) {}

	// Pipeline Stepper Interaction & 3D Satellite Pivot
	try {
		const stepBtns = document.querySelectorAll<HTMLButtonElement>('.progress-step');
		const stepTitle = document.getElementById('step-title');
		const stepDesc = document.getElementById('step-desc');

		const stepData = [
			{
				title: '01 // ARCHITECTURE & DESIGN',
				desc: 'Mixed-signal schematic capture, power distribution budgeting, and sensor interfacing.'
			},
			{
				title: '02 // ASSEMBLY, INTEGRATION & TEST (AIT)',
				desc: 'Breadboard bringup, signal integrity measurement, and sensor calibration across operating conditions.'
			},
			{
				title: '03 // EMBEDDED FIRMWARE & DRIVERS',
				desc: 'Low-jitter FreeRTOS scheduling, DMA peripheral handling, and deterministic state machine control.'
			},
			{
				title: '04 // FLIGHT OPS & TELEMETRY',
				desc: 'Hardware-in-the-loop validation, automated data logging, and Python analytics pipelines.'
			}
		];

		stepBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const stepIdx = parseInt(btn.dataset.step || '0', 10);
				stepBtns.forEach((b) => b.classList.toggle('active', b === btn));

				if (stepTitle && stepDesc && stepData[stepIdx]) {
					stepTitle.textContent = stepData[stepIdx].title;
					stepDesc.textContent = stepData[stepIdx].desc;
				}

				if (typeof (window as any).setSatelliteStep === 'function') {
					(window as any).setSatelliteStep(stepIdx);
				}
			});
		});
	} catch (_) {}

	// Mobile nav toggle
	const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
	const navList = document.querySelector<HTMLUListElement>('#primary-navigation');

	menuToggle?.addEventListener('click', () => {
		const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
		menuToggle.setAttribute('aria-expanded', String(!isExpanded));
		if (navList) {
			navList.classList.toggle('open');
		}
	});

	// Close mobile menu on link click
	navList?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			if (window.innerWidth < 640) {
				menuToggle?.setAttribute('aria-expanded', 'false');
				navList?.classList.remove('open');
			}
		});
	});

	// Close mobile menu when clicking outside
	document.addEventListener('click', (e) => {
		if (window.innerWidth < 640 && navList?.classList.contains('open')) {
			const target = e.target as HTMLElement;
			if (!menuToggle?.contains(target) && !navList.contains(target)) {
				menuToggle?.setAttribute('aria-expanded', 'false');
				navList.classList.remove('open');
			}
		}
	});

	// Contact form client fetch handler
	const contactForm = document.querySelector<HTMLFormElement>('#contact-form');
	const contactStatus = document.querySelector<HTMLElement>('#contact-status');
	const contactSubmit = contactForm?.querySelector<HTMLButtonElement>('button[type="submit"]');

	contactForm?.addEventListener('submit', async (event) => {
		event.preventDefault();

		if (!contactStatus || !contactSubmit || !contactForm.checkValidity() || contactSubmit.disabled) {
			contactForm?.reportValidity();
			return;
		}

		contactSubmit.disabled = true;
		contactForm.setAttribute('aria-busy', 'true');
		contactStatus.className = 'font-mono text-xs text-[#00A3FF]';
		contactStatus.textContent = 'Transmitting packet…';

		try {
			const response = await fetch(contactForm.action, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
				body: JSON.stringify(Object.fromEntries(new FormData(contactForm)))
			});
			const result = (await response.json().catch(() => null)) as { code?: string; message?: string } | null;

			if (response.ok && result?.code === 'notification_failed') {
				contactStatus.className = 'font-mono text-xs text-[#FF5C00]';
				contactStatus.textContent = 'Packet logged, but notification delivery was delayed. Please try again later if unacknowledged.';
			} else if (response.ok && result?.code === 'sent') {
				contactStatus.className = 'font-mono text-xs text-[#10B981]';
				contactStatus.textContent = 'Transmission acknowledged. Packet delivered successfully.';
				contactForm.reset();
			} else {
				contactStatus.className = 'font-mono text-xs text-[#EF4444]';
				contactStatus.textContent = 'Transmission error. Unable to establish downlink right now.';
			}
		} catch {
			contactStatus.className = 'font-mono text-xs text-[#EF4444]';
			contactStatus.textContent = 'Network link failure. Please retry.';
		} finally {
			contactSubmit.disabled = false;
			contactForm.removeAttribute('aria-busy');
		}
	});
</script>

