<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	gsap.registerPlugin(ScrollTrigger);

	// Progressive Enhancement: reveal items & active navigation
	const root = document.documentElement;
	root.classList.add('js');

	const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (prefersReducedMotion || !('IntersectionObserver' in window)) {
		revealItems.forEach((item) => item.classList.add('is-visible'));
	} else {
		const revealObserver = new IntersectionObserver(
			(entries, observer) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						const item = entry.target as HTMLElement;
						item.style.transitionDelay = item.dataset.reveal ? (item.style.getPropertyValue('--reveal-delay') || '0ms') : '0ms';
						item.classList.add('is-visible');
						observer.unobserve(item);
					}
				});
			},
			{ threshold: 0.1, rootMargin: '0px 0px -30px' }
		);
		revealItems.forEach((item) => revealObserver.observe(item));
	}

	// Hero Entrance Animation (GSAP)
	try {
		const heroItems = Array.from(document.querySelectorAll<HTMLElement>('[data-hero-item]'))
			.sort((a, b) => Number(a.dataset.heroItem) - Number(b.dataset.heroItem));

		if (heroItems.length && !prefersReducedMotion) {
			const tl = gsap.timeline({ defaults: { ease: 'power3.out', duration: 0.55 } });
			heroItems.forEach((el, i) => {
				const delay = [0, 0.07, 0.14, 0.20][i] ?? i * 0.07;
				tl.from(el, { opacity: 0, y: 12, clearProps: 'all' }, delay);
			});
		} else if (heroItems.length) {
			heroItems.forEach((el) => { el.style.opacity = '1'; el.style.transform = 'none'; });
		}
	} catch (_) {}

	// Scroll Progress Bar
	try {
		const bar = document.querySelector<HTMLElement>('.scroll-progress-bar');
		if (bar) {
			const updateBar = () => {
				const scrollTop = window.scrollY;
				const docH = document.documentElement.scrollHeight - window.innerHeight;
				bar.style.transform = `scaleX(${docH > 0 ? scrollTop / docH : 0})`;
			};
			window.addEventListener('scroll', updateBar, { passive: true });
			updateBar();
		}
	} catch (_) {}

	// Homepage Section Scroll-Spy & Active Navigation
	try {
		const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
		const sectionIds = ['projects', 'capabilities', 'about', 'contact'];
		const sections = sectionIds.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];

		if (navLinks.length && sections.length) {
			let activeId = '';
			const setActive = (id: string) => {
				if (id === activeId) return;
				activeId = id;
				navLinks.forEach((a) => {
					const href = a.getAttribute('href')?.replace('#', '');
					const isActive = href === id;
					a.dataset.active = isActive ? 'true' : 'false';
					if (isActive) {
						a.setAttribute('aria-current', 'page');
					} else {
						a.removeAttribute('aria-current');
					}
				});
			};

			navLinks.forEach((a) => {
				a.addEventListener('click', () => {
					const href = a.getAttribute('href')?.replace('#', '');
					if (href) setActive(href);
				});
			});

			const spyObserver = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) setActive((entry.target as HTMLElement).id);
					});
				},
				{ rootMargin: '-30% 0px -60% 0px', threshold: 0 }
			);
			sections.forEach((s) => spyObserver.observe(s));
		}
	} catch (_) {}

	// Interactive Surface Pointer Spotlight
	try {
		if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
			const surfaces = document.querySelectorAll<HTMLElement>('.interactive-surface');
			if (surfaces.length) {
				let rafId = 0;
				const handler = (e: MouseEvent) => {
					cancelAnimationFrame(rafId);
					rafId = requestAnimationFrame(() => {
						surfaces.forEach((el) => {
							const rect = el.getBoundingClientRect();
							el.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
							el.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
						});
					});
				};
				document.addEventListener('pointermove', handler, { passive: true });
			}
		}
	} catch (_) {}

	// Mobile nav toggle with synchronized aria-expanded
	const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
	const navList = document.querySelector<HTMLUListElement>('#primary-navigation');

	menuToggle?.addEventListener('click', () => {
		const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
		menuToggle.setAttribute('aria-expanded', String(!isExpanded));
		if (navList) {
			navList.classList.toggle('open');
		}
	});

	// Close mobile menu on link click
	navList?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			if (window.innerWidth < 640) {
				menuToggle?.setAttribute('aria-expanded', 'false');
				navList?.classList.remove('open');
			}
		});
	});

	// Close mobile menu when clicking outside
	document.addEventListener('click', (e) => {
		if (window.innerWidth < 640 && navList?.classList.contains('open')) {
			const target = e.target as HTMLElement;
			if (!menuToggle?.contains(target) && !navList.contains(target)) {
				menuToggle?.setAttribute('aria-expanded', 'false');
				navList.classList.remove('open');
			}
		}
	});

	// Contact form client fetch handler
	const contactForm = document.querySelector<HTMLFormElement>('#contact-form');
	const contactStatus = document.querySelector<HTMLElement>('#contact-status');
	const contactSubmit = contactForm?.querySelector<HTMLButtonElement>('button[type="submit"]');

	contactForm?.addEventListener('submit', async (event) => {
		event.preventDefault();

		if (!contactStatus || !contactSubmit || !contactForm.checkValidity() || contactSubmit.disabled) {
			contactForm?.reportValidity();
			return;
		}

		contactSubmit.disabled = true;
		contactForm.setAttribute('aria-busy', 'true');
		contactStatus.className = 'mono-data text-xs text-[#A1A1AA]';
		contactStatus.textContent = 'Transmitting message…';

		try {
			const response = await fetch(contactForm.action, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
				body: JSON.stringify(Object.fromEntries(new FormData(contactForm)))
			});
			const result = (await response.json().catch(() => null)) as { code?: string; message?: string } | null;

			if (response.ok && result?.code === 'notification_failed') {
				contactStatus.className = 'mono-data text-xs status-error-text';
				contactStatus.textContent = 'Message saved, but notification delivery was delayed. Please try again later if unacknowledged.';
			} else if (response.ok && result?.code === 'sent') {
				contactStatus.className = 'mono-data text-xs status-success-text';
				contactStatus.textContent = 'Message sent successfully. Thank you.';
				contactForm.reset();
			} else {
				contactStatus.className = 'mono-data text-xs status-error-text';
				contactStatus.textContent = 'Unable to transmit message right now. Please try again.';
			}
		} catch {
			contactStatus.className = 'mono-data text-xs status-error-text';
			contactStatus.textContent = 'Network error. Please try again.';
		} finally {
			contactSubmit.disabled = false;
			contactForm.removeAttribute('aria-busy');
		}
	});
</script>

