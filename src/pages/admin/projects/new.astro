---
// src/pages/admin/projects/new.astro — Create Engineering Project Specification
import Layout from '../../../layouts/Layout.astro';
import ProjectForm from '../../../components/admin/ProjectForm.astro';
import { authorizeAdmin } from '../../../lib/admin-auth';

const authorization = await authorizeAdmin(Astro);
if (authorization.status === 'unauthenticated') return Astro.redirect('/admin/login');
if (authorization.status === 'forbidden') return new Response('Forbidden', { status: 403 });

const errorMessage =
	Astro.url.searchParams.get('error') === 'invalid'
		? 'The project could not be saved. Check all required fields and try again.'
		: Astro.url.searchParams.get('error') === 'duplicate'
			? 'That slug is already in use. Choose another unique slug.'
			: Astro.url.searchParams.get('error') === 'database'
				? 'The project could not be saved because of a database error.'
				: null;
---

<Layout title="New System Record — Admin — Jagan">
	<!-- Ambient Background Orbs (Electric Cyan, Amethyst Violet) -->
	<div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
		<div class="absolute -left-40 top-10 w-[550px] h-[550px] rounded-full blur-[140px] opacity-25 bg-[#00C2EE]"></div>
		<div class="absolute -right-40 top-1/3 w-[600px] h-[600px] rounded-full blur-[160px] opacity-20 bg-[#8B3DFF]"></div>
		<div class="absolute inset-0 opacity-[0.05]" style="background-image: linear-gradient(rgb(255 255 255 / 0.4) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 0.4) 1px, transparent 1px); background-size: 56px 56px;"></div>
	</div>

	<main class="form-shell relative" id="main-content">
		<header class="form-page-header border-b border-white/[0.08] pb-6 mb-8">
			<div class="breadcrumb-row flex items-center gap-2 font-mono text-xs text-slate-400 mb-2">
				<a class="back-link hover:text-[#00C2EE] transition-colors" href="/admin/projects">← SYSTEM REGISTRY</a>
				<span class="divider text-white/20">/</span>
				<span class="mono-tag text-[#00C2EE] font-semibold">NEW RECORD</span>
			</div>
			<h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-white mb-1">
				Author System <span class="font-serif italic font-normal text-[#00C2EE]">Record.</span>
			</h1>
			<p class="page-intro text-xs font-mono text-slate-400">Author a new engineering system or hardware concept record in draft state.</p>
		</header>

		<section class="form-content-wrap" aria-labelledby="new-project-title">
			<h2 id="new-project-title" class="visually-hidden">New project specification form</h2>
			<ProjectForm action="/api/admin/projects" submitLabel="Create System Record" errorMessage={errorMessage ?? undefined} />
		</section>
	</main>
</Layout>

<style>
	.form-shell {
		width: min(960px, calc(100% - 3rem));
		margin-inline: auto;
		padding-block: 3.5rem 6rem;
		display: grid;
		gap: 2.25rem;
	}

	.form-page-header {
		padding-bottom: 1.75rem;
		border-bottom: 1px solid var(--line-subtle);
	}

	.breadcrumb-row {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin-bottom: 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.65rem;
	}

	.back-link {
		color: var(--text-muted);
		transition: color 180ms ease;
	}

	.back-link:hover {
		color: var(--text-primary);
	}

	.divider {
		color: var(--line-strong);
	}

	.mono-tag {
		color: var(--text-secondary);
		letter-spacing: 0.08em;
	}

	h1 {
		margin: 0 0 0.5rem;
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.1;
		letter-spacing: -0.04em;
	}

	.page-intro {
		margin: 0;
		color: var(--text-secondary);
		font-size: 0.92rem;
		max-width: 600px;
		line-height: 1.6;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
</style>
