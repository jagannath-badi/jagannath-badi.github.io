---
// src/components/SiteNav.astro — Fixed Glassmorphic Navigation Pill with Mobile Drawer
const links = [
  { href: '#hero', label: 'INDEX' },
  { href: '#subsystems', label: 'SUBSYSTEMS' },
  { href: '#telemetry-workbench', label: 'DSP LAB' },
  { href: '#projects', label: 'PROJECTS' },
  { href: '#uplink', label: 'UPLINK' },
];
---

<header class="fixed inset-x-0 top-3 sm:top-5 z-50 flex justify-center px-3 sm:px-4 pointer-events-none">
  <nav
    aria-label="Primary"
    class="pointer-events-auto flex w-full max-w-4xl items-center justify-between gap-3 sm:gap-4 rounded-full border border-white/10 bg-[#07090E]/85 px-4 sm:px-6 py-2.5 sm:py-3 backdrop-blur-md shadow-[0_10px_40px_rgba(0,0,0,0.8)]"
  >
    <!-- Brand / Status -->
    <a href="#hero" class="flex shrink-0 items-center gap-2.5 sm:gap-3 whitespace-nowrap text-xs font-mono tracking-[0.2em] text-white hover:text-[#00C2EE] transition-colors min-h-[44px]">
      <span class="led inline-block w-2 h-2 rounded-full bg-[#00FF9C]" aria-hidden="true"></span>
      <span class="font-bold tracking-wider">JAGAN // ECE</span>
      <span class="sr-only">System status: online</span>
    </a>

    <!-- Desktop Navigation Links -->
    <ul class="hidden md:flex items-center gap-6 text-xs font-mono uppercase tracking-[0.15em] text-slate-400">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class="transition-colors hover:text-[#00C2EE] py-2 px-1 inline-flex items-center min-h-[44px]"
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Desktop Operator Link -->
    <a
      href="/admin"
      class="hidden md:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-white/10 bg-white/5 font-mono text-[10px] text-[#A47BFF] hover:border-[#8B3DFF] hover:text-white transition-all min-h-[36px]"
      title="Access Admin CMS"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-[#8B3DFF]"></span>
      <span>[OP]</span>
    </a>

    <!-- Mobile Menu Button (Visible strictly on mobile < md) -->
    <button
      type="button"
      id="mobile-nav-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav-drawer"
      aria-label="Toggle navigation menu"
      class="md:hidden inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-white/15 bg-white/5 text-[10px] font-mono uppercase tracking-widest text-[#00C2EE] hover:bg-white/10 transition-colors min-h-[40px]"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-[#00C2EE] animate-pulse"></span>
      <span id="nav-toggle-text">MENU</span>
    </button>
  </nav>

  <!-- Mobile Fullscreen Glass Drawer -->
  <div
    id="mobile-nav-drawer"
    aria-hidden="true"
    class="pointer-events-none fixed inset-0 z-[60] bg-[#05060A]/95 backdrop-blur-2xl flex flex-col justify-between p-6 opacity-0 transition-opacity duration-300 data-[open=true]:opacity-100 data-[open=true]:pointer-events-auto"
  >
    <!-- Drawer Header -->
    <div class="flex items-center justify-between border-b border-white/10 pb-4">
      <div class="flex items-center gap-2.5 font-mono text-xs text-white">
        <span class="w-2 h-2 rounded-full bg-[#00FF9C]"></span>
        <span class="font-bold tracking-widest">JAGAN // ECE</span>
      </div>
      <button
        type="button"
        id="mobile-nav-close"
        aria-label="Close menu"
        class="font-mono text-xs text-slate-400 hover:text-white px-3 py-2 rounded-lg border border-white/10 bg-white/5 min-h-[44px]"
      >
        ✕ CLOSE
      </button>
    </div>

    <!-- Drawer Navigation Links -->
    <ul class="flex flex-col gap-2 my-auto py-8">
      {links.map((l, i) => (
        <li>
          <a
            href={l.href}
            class="mobile-nav-link flex items-center justify-between py-4 px-3 rounded-xl font-mono text-base uppercase tracking-wider text-slate-300 hover:text-[#00C2EE] hover:bg-white/5 transition-all min-h-[48px] border-b border-white/5"
          >
            <span>0{i + 1} // {l.label}</span>
            <span class="text-[#00C2EE] text-lg">→</span>
          </a>
        </li>
      ))}
    </ul>

    <!-- Drawer Footer Actions -->
    <div class="border-t border-white/10 pt-5 flex items-center justify-between gap-4 font-mono text-xs">
      <a
        href="/admin"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-[#A47BFF]/30 bg-[#A47BFF]/10 text-[#A47BFF] hover:bg-[#A47BFF]/20 transition-colors min-h-[44px]"
      >
        <span class="w-2 h-2 rounded-full bg-[#8B3DFF]"></span>
        <span>ADMIN [OP]</span>
      </a>
      <a
        href="https://github.com/jagannath-badi"
        target="_blank"
        rel="noopener noreferrer"
        class="text-slate-400 hover:text-[#00C2EE] transition-colors py-2 min-h-[44px] flex items-center"
      >
        GITHUB ↗
      </a>
    </div>
  </div>
</header>

<script>
  function initMobileNav() {
    const toggleBtn = document.querySelector<HTMLButtonElement>('#mobile-nav-toggle');
    const closeBtn = document.querySelector<HTMLButtonElement>('#mobile-nav-close');
    const drawer = document.querySelector<HTMLElement>('#mobile-nav-drawer');
    const links = document.querySelectorAll<HTMLAnchorElement>('.mobile-nav-link');

    if (!toggleBtn || !drawer) return;

    const openDrawer = () => {
      drawer.setAttribute('data-open', 'true');
      drawer.setAttribute('aria-hidden', 'false');
      toggleBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    };

    const closeDrawer = () => {
      drawer.removeAttribute('data-open');
      drawer.setAttribute('aria-hidden', 'true');
      toggleBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };

    toggleBtn.addEventListener('click', () => {
      const isOpen = drawer.getAttribute('data-open') === 'true';
      if (isOpen) closeDrawer();
      else openDrawer();
    });

    closeBtn?.addEventListener('click', closeDrawer);

    // Close when a navigation link is clicked
    links.forEach((l) => {
      l.addEventListener('click', closeDrawer);
    });

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.getAttribute('data-open') === 'true') {
        closeDrawer();
      }
    });
  }

  document.addEventListener('astro:page-load', initMobileNav);
</script>
