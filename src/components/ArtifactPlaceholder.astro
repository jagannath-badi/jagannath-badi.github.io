---
// src/components/ArtifactPlaceholder.astro — Interactive Hardware Schematic & Telemetry Blueprint Placeholder
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Hardware Schematic / Architecture Diagram',
	description = 'Schematics, bench traces, and hardware capture can be inspected or attached via the Admin Dashboard.'
} = Astro.props;
---

<div class="artifact-placeholder p-6 rounded-lg bg-[#07090E] border border-white/10 relative overflow-hidden my-4 group">
	<!-- Ambient glow backdrop -->
	<div class="absolute -right-16 -top-16 w-48 h-48 rounded-full bg-[#00A6E8]/10 blur-3xl pointer-events-none group-hover:bg-[#8B3DFF]/15 transition-all duration-700"></div>
	<div class="absolute -left-16 -bottom-16 w-48 h-48 rounded-full bg-[#FF2D95]/10 blur-3xl pointer-events-none group-hover:bg-[#00A6E8]/15 transition-all duration-700"></div>

	<div class="flex items-center justify-between border-b border-white/5 pb-3 mb-4 relative z-10">
		<div class="flex items-center gap-2">
			<span class="w-2 h-2 rounded-full bg-[#00A6E8] animate-pulse"></span>
			<span class="font-mono text-xs uppercase tracking-wider text-slate-200 font-semibold">{title}</span>
		</div>
		<span class="font-mono text-[10px] text-[#A47BFF] uppercase tracking-widest bg-[#8B3DFF]/15 px-2.5 py-0.5 rounded border border-[#8B3DFF]/30">
			CAD // SCHEMATIC
		</span>
	</div>

	<!-- Vector Blueprint Circuit Grid -->
	<div class="h-44 sm:h-56 w-full rounded border border-dashed border-white/15 bg-[#040508] relative flex flex-col items-center justify-center p-6 text-center select-none overflow-hidden">
		<svg class="absolute inset-0 w-full h-full opacity-25 pointer-events-none" xmlns="http://www.w3.org/2000/svg">
			<defs>
				<pattern id="pcb-grid" width="32" height="32" patternUnits="userSpaceOnUse">
					<path d="M 32 0 L 0 0 0 32" fill="none" stroke="#38BDF8" stroke-width="0.5" stroke-opacity="0.6" />
					<circle cx="16" cy="16" r="1" fill="#A47BFF" fill-opacity="0.8" />
				</pattern>
			</defs>
			<rect width="100%" height="100%" fill="url(#pcb-grid)" />
		</svg>

		<div class="relative z-10 max-w-md">
			<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 mb-3 text-[11px] font-mono text-[#00A6E8]">
				<span class="w-1.5 h-1.5 rounded-full bg-[#00FF9C]"></span>
				<span>SYSTEM ARTIFACT // 50Ω IMPEDANCE MATCH</span>
			</div>
			<p class="text-xs text-slate-400 font-light leading-relaxed">{description}</p>
		</div>
	</div>
</div>
