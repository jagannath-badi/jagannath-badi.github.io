---
// src/components/ArtifactPlaceholder.astro
interface Props {
  title?: string;
  description?: string;
  class?: string;
}

const {
  title = "Hardware Prototype / Schematic Capture",
  description = "Hardware prototype photograph or schematic capture can be attached via the Admin Dashboard or project assets.",
  class: className = ""
} = Astro.props;
---

<div class={`w-full bg-[#0A0D14] border border-dashed border-[#1E2330] p-6 sm:p-8 text-center rounded-sm flex flex-col items-center justify-center min-h-[220px] ${className}`}>
  <div class="inline-flex items-center gap-2 px-2.5 py-1 mb-3 bg-[#121620] border border-[#1E2330] rounded-[2px]">
    <span class="w-1.5 h-1.5 bg-[#38BDF8] rounded-full animate-pulse" aria-hidden="true"></span>
    <span class="mono-label text-[#A1A1AA] text-[11px]">[ARTIFACT SLOT // PENDING UPLOAD]</span>
  </div>
  <p class="text-sm font-semibold text-[#F4F4F6] mb-1 font-sans">{title}</p>
  <p class="text-xs text-[#71717A] max-w-md mx-auto leading-relaxed font-sans">{description}</p>
</div>
